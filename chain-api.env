# chain-api engine config — copy to ../engine/.env and start: npm run dev
# Leave API_KEY and ADMIN_KEY empty — seed auto-generates and prints them once.

PORT=3000
SQLITE_DB_PATH=./data/chain-api.db

BITCOIN_RPC_URL=http://localhost:18443
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=bitcoin
BITCOIN_NETWORK=regtest

API_KEY=                  # Auto-generated on first seed (starts with cak_)
ADMIN_KEY=                # Auto-generated on first seed (starts with aak_)
TENANT_NAME=Dev Tenant

BTC_DEFAULT_CONFIRMATIONS=1
BTC_FINALITY_CONFIRMATIONS=6

WORKERS_ENABLED=true
DEPOSIT_MONITOR_INTERVAL_MS=15000
WEBHOOK_DELIVERY_INTERVAL_MS=10000
TX_STATUS_INTERVAL_MS=30000

RATE_LIMIT_PER_MIN=10000
LOG_LEVEL=debug
