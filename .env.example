# UI proxy config — copy to .env and fill in values from engine seed output.
# Docker Compose auto-loads .env from this directory.

# chain-api engine URL (use host.docker.internal when engine runs on host, not in Docker)
CHAIN_API_URL=http://host.docker.internal:3000

# Paste keys printed by: cd ../engine && npm run db:seed
CHAIN_API_KEY=
CHAIN_API_ADMIN_KEY=
